@using Esfa.Recruit.Shared.Web.TagHelpers
@model Esfa.Recruit.Provider.Web.ViewModels.VacancyManage.ManageVacancyViewModel
@{
    ViewBag.GaData.Vpv = "/recruitment/provider/page-manage-vacancy";
    ViewBag.Title = "Manage vacancy";
}
@section BackLink {
    <a asp-route="@RouteNames.VacanciesGetAll" asp-route-filter="@Model.FilteringOptions" asp-route-ukprn="@Model.Ukprn" class="govuk-back-link">Back</a>
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div asp-show="@Model.CanShowApplicationsStatusChangeBanner" class="govuk-notification-banner govuk-notification-banner--success" role="alert"
             aria-labelledby="govuk-notification-banner-title"
             data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header">
                <h2 class="govuk-notification-banner__title">
                    Success
                </h2>
            </div>
            <div class="govuk-notification-banner__content">
                <h3 class="govuk-notification-banner__heading">
                    @Model.ApplicationReviewStatusChangeBannerHeader
                </h3>
                <p class="govuk-body">@Model.ApplicationReviewStatusChangeBannerMessage</p>
            </div>
        </div>
        <div asp-show="@Model.CanShowApplicationReviewStatusHeader" class="das-notification das-notification--information">
            <p class="das-notification__body">
                @Model.ApplicationReviewStatusHeaderInfoMessage
            </p>
        </div>
        <govuk-banner asp-show="@Model.CanShowOutstandingApplicationsBannerMessage" type="BannerStyle.Important">
            <h3 class="govuk-notification-banner__heading">
                @Model.TotalOutstandingApplicationsBannerMessage
            </h3>
        </govuk-banner>
        <govuk-tag-foundation asp-show="@Model.ApprenticeshipType.IsFoundation()" class="govuk-!-margin-bottom-4" />
        <span class="govuk-caption-l">@Model.EmployerName</span>
        <h1 class="govuk-heading-l govuk-!-margin-top-2 govuk-!-margin-bottom-2">@Model.Title</h1>
        <p class="govuk-body-l">Vacancy reference: VAC@(Model.VacancyReference)</p>
        <p asp-show="@Model.IsWithdrawn" class="govuk-inset-text">
            This vacancy has issues and was closed on @Model.WithdrawnDate.
        </p>
    </div>
    <div class="govuk-grid-column-full">
        <div asp-show="Model.HasVacancyClosedInfoMessage" class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header">
                <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                    Success
                </h2>
            </div>
            <div class="govuk-notification-banner__content">
                <h3 class="govuk-notification-banner__heading">
                    @Model.VacancyClosedInfoMessage
                </h3>
                <p class="govuk-body">The vacancy will be unpublished from Find an apprenticeship within the next hour.</p>
            </div>
        </div>
    </div>
    <div class="govuk-grid-column-two-thirds">
        <h2 class="govuk-heading-m govuk-!-margin-top-5">Vacancy summary</h2>
        <p asp-show="@Model.Status == VacancyStatus.Submitted" class="govuk-body">
            This vacancy has been sent to us for review. We’ll tell you within 1 working day if you need to make any edits to this vacancy.
        </p>
        <p asp-show="@Model.Status == VacancyStatus.Review" class="govuk-body">
            This vacancy needs to be approved by the employer. Once approved, it will be sent to DfE for review.
        </p>
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Status
                </dt>
                <dd class="govuk-summary-list__value das-float-right">
                    <govuk-tag-vacancy-status status="@Model.Status" />
                </dd>
                <dd class="govuk-summary-list__actions">
                    <a asp-show="@Model.CanShowCloseVacancyLink" asp-route="@RouteNames.CloseVacancy_Get" asp-all-route-data="@Model.RouteDictionary" class="govuk-link">Change</a>
                </dd>
            </div>
            <div class="govuk-summary-list__row border-bottom-none" asp-show="@Model.CanShowStartAndClosingDates">
                <dt class="govuk-summary-list__key">
                    Closing date
                    <br>
                    <br>
                    Possible start date
                </dt>
                <dd class="govuk-summary-list__value das-align-end">
                    @Model.ClosingDate
                    <br>
                    <br>
                    @Model.PossibleStartDate
                </dd>
                <dd class="govuk-summary-list__actions">
                    <a asp-show="@Model.CanShowEditVacancyLink" asp-route="@RouteNames.VacancyEditDates_Get" asp-all-route-data="@Model.RouteDictionary" class="govuk-link">Change</a>
                </dd>
            </div>
        </dl>
        <div class="govuk-button-group">
            <a asp-route="@RouteNames.DisplayFullVacancy_Get" asp-all-route-data="@Model.RouteDictionary" class="govuk-link">View vacancy</a>
            <a asp-show="@Model.CanShowCloneVacancyLink" asp-route="@RouteNames.CloneVacancy_Get" asp-all-route-data="@Model.RouteDictionary" class="govuk-link">Clone vacancy</a>
            <a asp-show="@Model.CanShowDeleteVacancyLink" asp-route="@RouteNames.DeleteVacancy_Get" asp-all-route-data="@Model.RouteDictionary" class="govuk-link">Delete vacancy</a>
            <a asp-show="@Model.CanShowArchiveVacancyLink" asp-route="@RouteNames.ArchiveVacancy_Get" asp-all-route-data="@Model.RouteDictionary" class="govuk-link">Archive vacancy</a>
        </div>
        <govuk-inset asp-show="@Model.CanShowArchiveInsetText">
            <div asp-show="Model.Status == VacancyStatus.Archived">
                An archived vacancy can be cloned to list it again.
            </div>
            <div asp-show="Model.Status == VacancyStatus.Closed">
                Closed vacancies can be archived when all applicants have received their outcome. You can clone an archived vacancy to advertise it again.
            </div>
        </govuk-inset>
    </div>
    <div class="govuk-grid-column-full">
        <div asp-show="@Model.CanShowVacancyAnalytics">
            <h3 class="govuk-heading-s govuk-!-margin-top-5 govuk-!-margin-bottom-2">
                Analytics
            </h3>
            <p class="govuk-body-m das-!-color-dark-grey">
                Data from when the vacancy was live on Find an apprenticeship.
            </p>
            <div asp-show="@Model.VacancyAnalyticsViewModel.HasAnalytics">
                <partial asp-show="@Model.IsApplyThroughFaaVacancy" name="@RecruitPartialNames.ApplyThroughFaaVacancyAnalytics" for="@Model.VacancyAnalyticsViewModel.AnalyticsSummary" />
                <partial asp-show="@Model.IsApplyThroughExternalApplicationSiteVacancy" name="@RecruitPartialNames.ApplyThroughExternalApplicationSiteVacancyAnalytics" for="@Model.VacancyAnalyticsViewModel.AnalyticsSummary" />
            </div>
        </div>
    </div>
</div>
@if (Model.CanShowApplicationsSection)
{
    <div class="govuk-grid-row govuk-!-margin-top-9">
        <div class="govuk-grid-column-two-thirds">
            <div>
                <h2 class="govuk-heading-m">
                    Applications (@Model.TotalUnfilteredApplicationsCount)
                </h2>
            </div>
            <div asp-show="@(Model.IsApplyThroughFaaVacancy || Model.IsApplyThroughFatVacancy)">
                <p class="govuk-body" asp-show="@Model.CanShowShareMultipleApplicationsLink">
                    <a asp-route="@RouteNames.ApplicationReviewsToShare_Get" asp-all-route-data="@Model.RouteDictionary" class="govuk-link govuk-!-margin-top-2 govuk-!-margin-bottom-4">Share multiple applications with employer</a>
                </p>
                <p class="govuk-body" asp-show="@Model.CanShowMultipleApplicationsUnsuccessfulLink">
                    <a asp-route="@RouteNames.ApplicationReviewsToUnsuccessful_Get" asp-all-route-data="@Model.RouteDictionary" class="govuk-link govuk-!-margin-top-2 govuk-!-margin-bottom-4">Make multiple applications unsuccessful</a>
                </p>
            </div>
            <div class="govuk-body govuk-hint">
                <p asp-show="@Model.IsDisabilityConfident" class="govuk-label govuk-inset-text">
                    @Model.EmployerName is signed up to the <a href="https://www.gov.uk/government/collections/disability-confident-campaign" class="govuk-link" rel="noopener" target="_blank" title="Disability Confident employer scheme and guidance (opens in new tab)">Disability Confident scheme (opens in new tab).</a>
                </p>
            </div>
        </div>
    </div>
    <div class="govuk-grid-row govuk-!-margin-top-3">
        <div class="govuk-grid-column-two-thirds">
            <form method="get" autocomplete="off">
                <div class="govuk-form-group">
                    <label for="applicantFilter" class="govuk-label">
                        Search by applicant name
                    </label>
                    <div class="das-search-form__group">
                        <input id="applicantFilter" name="applicantFilter" title="Search" class="govuk-input das-search-form__input" type="text" maxlength="200" value="@Model.SelectedApplicantName" />
                        <div class="das-search-form__button-wrap">
                            <button class="govuk-button das-search-form__button" type="submit">
                                Search
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="govuk-grid-column-one-third" asp-show="Model.Applications is { CanShowLocationFilter: true }">
            <form method="get" autocomplete="off">
                <div class="govuk-form-group">
                    <label class="govuk-label" for="locationFilter">Filter by location</label>
                    <select class="govuk-select"
                            id="locationFilter"
                            name="locationFilter"
                            data-ays-ignore="true">
                        <option value="All">All locations</option>
                        @foreach (var location in Model.Applications.EmploymentLocations)
                        {
                            if (location == Model.Applications.SelectedLocation)
                            {
                                <option value="@location" selected>@location</option>
                            }
                            else
                            {
                                <option value="@location">@location</option>
                            }
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>
    <div asp-show="@(Model.IsApplyThroughFaaVacancy || Model.IsApplyThroughFatVacancy)">
        <partial asp-show="@Model.HasApplications" name="@PartialNames.VacancyApplicationsTable" for="Applications" />
        <p asp-show="@Model.HasNoApplications" class="govuk-body govuk-!-margin-bottom-0">
            <govuk-inset asp-show="@Model.CanShowNoApplicationsInsetText">
                @if (Model.IsVacancyClosed)
                {
                    <span>You didn't receive any applications for this vacancy.</span>
                }
                else
                {
                    <span>Applications will be displayed here once you start receiving them.</span>
                }
            </govuk-inset>
        </p>
    </div>
}
else
{
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div>
                <h2 class="govuk-heading-m govuk-!-margin-top-3">
                    Applications
                </h2>
            </div>
            <govuk-inset>
                Applications will be displayed here once the vacancy is live and applications have been received.
            </govuk-inset>
        </div>
    </div>
}