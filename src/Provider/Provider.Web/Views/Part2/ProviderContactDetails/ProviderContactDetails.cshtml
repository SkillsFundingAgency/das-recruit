@model Esfa.Recruit.Provider.Web.ViewModels.Part2.ProviderContactDetails.ProviderContactDetailsViewModel

@{
    ViewBag.GaData.Vpv = "/recruitment/provider/page-vacancy-provider-contact";
    ViewBag.Title = "Add contact information";
}

@section BackLink {
    <partial name="_TaskListBackLink" model="@(new BackLinkViewModel(Model.RouteDictionary, RouteNames.AboutEmployer_Get, Model.IsTaskListCompleted, Model.IsTaskList))" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <partial name="@PartialNames.ValidationSummary" model='new ValidationSummaryViewModel { ModelState = ViewData.ModelState, OrderedFieldNames = Model.OrderedFieldNames }' />
        <partial name="@PartialNames.ReviewSummary" for="Review" />

        <h1 class="govuk-heading-xl">
            <span class="govuk-caption-l">@Model.Title</span>
            Your contact details
        </h1>
        <p class="govuk-body govuk-!-margin-bottom-8">This should be someone an applicant can contact to ask questions about the apprenticeship position.</p>
        <form asp-route="@RouteNames.ProviderContactDetails_Post"  asp-all-route-data="@Model.RouteDictionary" asp-route-wizard="@Model.IsTaskList" novalidate>
             <div class="govuk-form-group">
                <div esfa-validation-marker-for="ProviderContactName" class="govuk-form-group">
                    <label asp-for="ProviderContactName" class="govuk-label">Full name (optional)</label>
                    <span esfa-validation-message-for="ProviderContactName" class="govuk-error-message"></span>
                    <input asp-for="ProviderContactName" class="govuk-input govuk-!-width-three-quarters" maxlength="100" />
                </div>
                <div esfa-validation-marker-for="ProviderContactEmail" class="govuk-form-group">
                    <label asp-for="ProviderContactEmail" class="govuk-label">Email address (optional)</label>
                    <span esfa-validation-message-for="ProviderContactEmail" class="govuk-error-message"></span>
                    <input asp-for="ProviderContactEmail" class="govuk-input govuk-!-width-three-quarters" maxlength="100" />
                </div>
                <div esfa-validation-marker-for="ProviderContactPhone" class="govuk-form-group">
                    <label asp-for="ProviderContactPhone" class="govuk-label">Phone number (optional)</label>
                    <span esfa-validation-message-for="ProviderContactPhone" class="govuk-error-message"></span>
                    <input asp-for="ProviderContactPhone" class="govuk-input govuk-!-width-three-quarters" type="tel" maxlength="16" />
                </div>
             </div>
             <div class="govuk-button-group govuk-!-margin-top-8">
                 <input type="submit" value="Save and continue" esfa-automation="btn-continue" class="govuk-button save-button"/>
                 <a asp-route="@RouteNames.Dashboard_Get" asp-all-route-data="@Model.RouteDictionary" esfa-automation="link-cancel" class="govuk-link govuk-link--no-visited-state">Cancel</a>
              </div>
         </form>
    </div>
</div>