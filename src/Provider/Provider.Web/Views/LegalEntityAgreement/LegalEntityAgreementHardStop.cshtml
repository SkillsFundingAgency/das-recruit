@model Esfa.Recruit.Provider.Web.ViewModels.LegalEntityAgreement.LegalEntityAgreementHardStopViewModel

@{
    ViewBag.Title = "Agreement not signed";
}

@section BackLink {
    <a asp-route="@RouteNames.Vacancy_Preview_Get" asp-route-ukprn="@Model.Ukprn" class="govuk-back-link">Back</a>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">You can’t submit this vacancy until the agreement is signed</h1>
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                @Model.LegalEntityName must have a signed Department for Education apprenticeship agreement before you can post vacancies on their behalf.
            </strong>
        </div>
        <p class="govuk-body">
            The vacancy has been saved as a draft. Once the employer has signed the agreement, you can resubmit it from the recruitment dashboard.
        </p>
        <p class="govuk-body">
            <a asp-route="@RouteNames.VacanciesGetAll" asp-route-filter="@FilteringOptions.All" asp-route-ukprn="@Model.Ukprn" class="govuk-button">Return to dashboard</a>
        </p>
    </div>
</div>